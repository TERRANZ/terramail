<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.terramail.controller.MessageTableController"
      styleClass="message-table-panel">
    
    <children>
        <!-- Header with folder info and actions -->
        <HBox styleClass="panel-header" alignment="CENTER_LEFT">
            <children>
                <Text fx:id="folderNameLabel" text="Inbox" styleClass="panel-title"/>
                <HBox HBox.hgrow="ALWAYS"/>
                
                <!-- Search field -->
                <TextField fx:id="searchField" promptText="Search..." 
                           styleClass="search-field"
                           onAction="#handleSearch"/>
                
                <!-- Action buttons -->
                <Button fx:id="replyButton" text="Reply" 
                        styleClass="action-button" visible="false"
                        onAction="#handleReply"/>
                <Button fx:id="forwardButton" text="Forward" 
                        styleClass="action-button" visible="false"
                        onAction="#handleForward"/>
                <Button fx:id="deleteButton" text="Delete" 
                        styleClass="action-button delete"
                        visible="false"
                        onAction="#handleDelete"/>
                <Button fx:id="syncButton" text="Sync" 
                        styleClass="icon-button"
                        onAction="#handleSync"/>
            </children>
            <padding>
                <Insets bottom="5" left="10" right="10" top="10"/>
            </padding>
        </HBox>
        
        <!-- Message count label -->
        <Text fx:id="messageCountLabel" text="0 messages" 
              styleClass="message-count"
              padding="new Insets(0, 10, 5, 10)"/>
        
        <!-- Message table -->
        <TableView fx:id="messageTableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="flagColumn" text="!" prefWidth="30" sortable="false"/>
                <TableColumn fx:id="readColumn" text="●" prefWidth="30" sortable="false"/>
                <TableColumn fx:id="subjectColumn" text="Subject" sortable="false"/>
                <TableColumn fx:id="fromColumn" text="From" sortable="false"/>
                <TableColumn fx:id="dateColumn" text="Date" prefWidth="120" sortable="false"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <padding>
                <Insets bottom="10" left="5" right="5" top="5"/>
            </padding>
        </TableView>
    </children>
</VBox>
