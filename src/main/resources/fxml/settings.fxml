<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<Dialog fx:id="settingsDialog" title="Settings"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.terramail.controller.SettingsController"
        styleClass="settings-dialog">
    
    <dialogPane>
        <content>
            <TabPane fx:id="settingsTabPane" tabClosingPolicy="UNAVAILABLE">
                
                <!-- Account Settings Tab -->
                <Tab text="Accounts">
                    <VBox spacing="10">
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Email Account:" minWidth="100"/>
                                <ComboBox fx:id="accountComboBox" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="addAccountButton" text="Add Account"/>
                                <Button fx:id="editAccountButton" text="Edit"/>
                                <Button fx:id="deleteAccountButton" text="Delete" styleClass="danger"/>
                            </HBox>
                            
                            <Separator/>
                            
                            <!-- Account details form -->
                            <VBox spacing="10">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Display Name:" minWidth="100"/>
                                        <TextField fx:id="displayNameField" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Email:" minWidth="100"/>
                                        <TextField fx:id="emailField" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Organization:" minWidth="100"/>
                                        <TextField fx:id="organizationField" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                </children>
                                <padding>
                                    <Insets bottom="10" left="10" right="10" top="10"/>
                                </padding>
                            </VBox>
                            
                            <Separator/>
                            
                            <!-- IMAP Settings -->
                            <VBox spacing="10">
                                <children>
                                    <Label text="IMAP Settings" styleClass="section-title"/>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Enabled:" minWidth="100"/>
                                        <ToggleGroup fx:id="imapEnabledGroup"/>
                                        <RadioButton text="Yes" toggleGroup="imapEnabledGroup" fx:id="imapEnabledYes" selected="true"/>
                                        <RadioButton text="No" toggleGroup="imapEnabledGroup" fx:id="imapEnabledNo"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Host:" minWidth="100"/>
                                        <TextField fx:id="imapHostField" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Port:" minWidth="100"/>
                                        <TextField fx:id="imapPortField" prefWidth="80"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Username:" minWidth="100"/>
                                        <TextField fx:id="imapUserField" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Password:" minWidth="100"/>
                                        <PasswordField fx:id="imapPasswordField" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                </children>
                                <padding>
                                    <Insets bottom="10" left="10" right="10" top="10"/>
                                </padding>
                            </VBox>
                            
                            <Separator/>
                            
                            <!-- SMTP Settings -->
                            <VBox spacing="10">
                                <children>
                                    <Label text="SMTP Settings" styleClass="section-title"/>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Enabled:" minWidth="100"/>
                                        <ToggleGroup fx:id="smtpEnabledGroup"/>
                                        <RadioButton text="Yes" toggleGroup="smtpEnabledGroup" fx:id="smtpEnabledYes" selected="true"/>
                                        <RadioButton text="No" toggleGroup="smtpEnabledGroup" fx:id="smtpEnabledNo"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Host:" minWidth="100"/>
                                        <TextField fx:id="smtpHostField" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Port:" minWidth="100"/>
                                        <TextField fx:id="smtpPortField" prefWidth="80"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Username:" minWidth="100"/>
                                        <TextField fx:id="smtpUserField" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Password:" minWidth="100"/>
                                        <PasswordField fx:id="smtpPasswordField" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                </children>
                                <padding>
                                    <Insets bottom="10" left="10" right="10" top="10"/>
                                </padding>
                            </VBox>
                        </children>
                    </VBox>
                </Tab>
                
                <!-- General Settings Tab -->
                <Tab text="General">
                    <VBox spacing="10">
                        <children>
                            <Label text="Application Settings" styleClass="section-title"/>
                            
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Check for new mail:" minWidth="150"/>
                                <ComboBox fx:id="syncIntervalCombo" prefWidth="150"/>
                                <Label text="minutes"/>
                            </HBox>
                            
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Open on system tray:" minWidth="150"/>
                                <CheckBox fx:id="systemTrayCheck" selected="true"/>
                            </HBox>
                            
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Show message previews:" minWidth="150"/>
                                <CheckBox fx:id="showPreviewsCheck" selected="true"/>
                            </HBox>
                            
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Default format:" minWidth="150"/>
                                <ComboBox fx:id="defaultFormatCombo" prefWidth="150">
                                    <items>
                                        <MenuItem text="Plain Text"/>
                                        <MenuItem text="HTML"/>
                                        <MenuItem text="Both (HTML first)"/>
                                    </items>
                                </ComboBox>
                            </HBox>
                        </children>
                        <padding>
                            <Insets bottom="10" left="10" right="10" top="10"/>
                        </padding>
                    </VBox>
                </Tab>
            </TabPane>
        </content>
        
        <padding>
            <Insets bottom="10" left="10" right="10" top="10"/>
        </padding>
        
        <buttonBar>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <children>
                    <Button text="Cancel" buttonType="CANCEL" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="testConnectionButton" text="Test Connection" buttonType="SECONDARY"/>
                    <Button fx:id="saveButton" text="Save" buttonType="DEFAULT" defaultButton="true"/>
                </children>
            </HBox>
        </buttonBar>
    </dialogPane>
    
    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>
</Dialog>
